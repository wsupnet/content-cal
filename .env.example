# Optional. ContentCal works without a .env file and keeps its data in ./data.
# To change that, copy this file to .env (never commit .env) and edit it.

# Where your calendar.db, .session_secret and backups live.
#   Linux: CONTENTCAL_DATA=/srv/contentcal
#   NAS: CONTENTCAL_DATA=/volume1/docker/appdata/contentcal
#   Windows: CONTENTCAL_DATA=C:/ContentCal/data
# CONTENTCAL_DATA=./data

# Refuse to start if calendar.db is missing, instead of creating an empty one.
# Worth turning on once your install holds real data, especially if the folder
# is on a drive that might not be mounted. Leave it off for the very first run.
# REQUIRE_EXISTING_DB=1
