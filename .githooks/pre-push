#!/usr/bin/env bash
# Pre-push hook: run the backend regression suite before letting a push out.
# Configured via `make install-hooks`, which sets core.hooksPath=.githooks
# so this file is versioned in the repo and gets restored on fresh clones.
#
# Bypass (rare, e.g. WIP branch): `git push --no-verify`

set -e

cd "$(git rev-parse --show-toplevel)"

# Tests run in Docker (see `make test`), so Docker is the only requirement.
if ! command -v docker >/dev/null 2>&1; then
  echo "✗ Docker is not installed or not on PATH. It's needed to run the test suite."
  exit 1
fi
if ! docker info >/dev/null 2>&1; then
  echo "✗ Docker isn't running. Start Docker Desktop (or the Docker service), then push again."
  exit 1
fi

echo "→ Running backend regression suite before push…"
make test
echo "✓ Tests passed. Pushing."
